{
  "name": "social-media-app",
  "version": "1.0.0",
  "description": "Social media backend with Express, TypeScript, Zod, and JWT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config dist/main.js dotenv_config_path=.env.prod",
    "dev": "tsc -w",
    "dev:run": "node --watch -r dotenv/config dist/main.js dotenv_config_path=.env.dev",
    "start:dev": "concurrently \"npm run dev\" \"npm run dev:run\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1117.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
